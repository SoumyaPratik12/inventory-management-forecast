# Example .env for AI-enabled Inventory Sentinel

# AI provider: 'openai' or 'azure' (leave empty to disable AI)
AI_PROVIDER=openai
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_MODEL=gpt-4o-mini
AI_ENDPOINT=  # (optional) use for Azure or custom endpoints

# Opt-in automation: set to true to allow AI to suggest and perform actions
AI_AUTOMATE=false
AI_TIMEOUT=10

# Safety controls
# When AI_SANDBOX=true, mitigation actions are dry-run only (recommended for testing)
AI_SANDBOX=true
# To allow real automated mitigation set to true (use with care and an auditable environment)
AI_ALLOW_AUTOMATED_MITIGATION=false

# Additional notes:
# - Keep API keys secret and use a secure secrets manager where possible.
# - Start with AI_AUTOMATE=false and AI_SANDBOX=true in production to audit decisions before enabling automation.
